            if (isFavScreen && !favIds.includes(u.id)) return false;
            const mS = !q || u.name.toLowerCase().includes(q.toLowerCase()) || u.tags.some(t => t.toLowerCase().includes(q.toLowerCase()));
            const mF = f === "all" || (f === "host" && u.isHost) || (f === "companion" && u.lookingForCompanion);
            return mS && mF;
          });
          return (
            <div style={W}>
